    {
      "id": "L1",
      "beat": "B1_HOOK",
      "speaker": "narrator",
      "t0": 0.08,
      "t1": 3.88,
      "text": "When a helicopter's engine dies mid-air, the pilot slams this lever straight down."
    },
    {
      "id": "L2",
      "beat": "B2_CLUTCH",
      "speaker": "narrator",
      "t0": 4.05,
      "t1": 9.35,
      "text": "Inside the rotor sits a bicycle-style clutch that unlocks the blades so the dead engine can't brake them."
    },
    {
      "id": "L3",
      "beat": "B3_AIRFLOW",
      "speaker": "narrator",
      "t0": 9.55,
      "t1": 15.80,
      "text": "As the chopper glides down, air rushes up through the blades, spinning them like a wind turbine to store energy."
    },
    {
      "id": "L4",
      "beat": "B4_MAPLE",
      "speaker": "narrator",
      "t0": 16.00,
      "t1": 21.30,
      "text": "It copies a falling maple seed, trading height for spinning speed so the pilot stays in total control."
    },
    {
      "id": "L5",
      "beat": "B5_FLARE",
      "speaker": "narrator",
      "t0": 21.50,
      "t1": 26.15,
      "text": "Thirty feet above the roof, the pilot pulls up for one final burst of lift."
    },
    {
      "id": "L6",
      "beat": "B6_LANDING",
      "speaker": "narrator",
      "t0": 26.35,
      "t1": 29.82,
      "text": "That stored spin cushions the drop into a smooth, powerless landing."
    }
  ],
