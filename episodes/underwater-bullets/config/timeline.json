  "narration_lines": [
    {
      "id": "L1",
      "beat": "B1_HOOK",
      "speaker": "narrator",
      "t0": 0.08,
      "t1": 3.44,
      "text": "Movies show bullets chasing swimmers underwater. Instead, bullets stop at three feet."
    },
    {
      "id": "L2",
      "beat": "B2_ENTRY",
      "speaker": "narrator",
      "t0": 3.65,
      "t1": 8.85,
      "text": "The moment it leaves the barrel and slams into water, it hits a wall eight hundred times denser than air."
    },
    {
      "id": "L3",
      "beat": "B3_CAVITATION",
      "speaker": "narrator",
      "t0": 9.15,
      "t1": 14.85,
      "text": "Out front, extreme pressure boils the water instantly, wrapping the spinning nose inside a silver gas bubble."
    },
    {
      "id": "L4",
      "beat": "B4_SHATTER",
      "speaker": "narrator",
      "t0": 15.15,
      "t1": 20.85,
      "text": "But that speed backfires, the bubble collapses sideways, violently twisting the bullet until it shreds into tiny shards."
    },
    {
      "id": "L5",
      "beat": "B5_RACE",
      "speaker": "narrator",
      "t0": 21.15,
      "t1": 25.85,
      "text": "So firing faster actually makes it stop sooner. Meanwhile, a slower heavy round glides straight past three feet."
    },
    {
      "id": "L6",
      "beat": "B6_SAFE",
      "speaker": "narrator",
      "t0": 26.15,
      "t1": 29.85,
      "text": "Dive just three feet under the surface, and a deadly rifle turns into harmless scrap metal."
    }
  ],
