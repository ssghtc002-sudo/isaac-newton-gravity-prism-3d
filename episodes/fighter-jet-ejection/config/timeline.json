  "dialogue": [
    {
      "id": "L1",
      "beatId": "B1",
      "speaker": "narrator",
      "start": 0.08,
      "end": 4.68,
      "text": "Movies make ejecting look easy, but pulling this handle shrinks your spine an inch!"
    },
    {
      "id": "L2",
      "beatId": "B2",
      "speaker": "narrator",
      "start": 4.88,
      "end": 9.62,
      "text": "First, an explosive cord inside the glass shatters the canopy in fifty milliseconds."
    },
    {
      "id": "L3",
      "beatId": "B3",
      "speaker": "narrator",
      "start": 9.88,
      "end": 14.60,
      "text": "Cable garters whip your legs back, as a catapult charge blasts you up the rails."
    },
    {
      "id": "L4",
      "beatId": "B4",
      "speaker": "narrator",
      "start": 14.88,
      "end": 20.38,
      "text": "Sixteen Gs squash your spinal discs flat, shrinking you by two and a half centimeters!"
    },
    {
      "id": "L5",
      "beatId": "B5",
      "speaker": "narrator",
      "start": 20.68,
      "end": 25.32,
      "text": "Twin rockets clear the tail fin, while a drogue chute stops you from tumbling."
    },
    {
      "id": "L6",
      "beatId": "B6",
      "speaker": "narrator",
      "start": 25.58,
      "end": 29.75,
      "text": "The seat drops as your chute opens, leaving you shorter until gravity resets!"
    }
  ],
