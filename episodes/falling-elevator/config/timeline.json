  "dialogue": [
    {
      "id": "L1",
      "beatId": "B1",
      "speaker": "narrator",
      "start": 0.15,
      "end": 4.95,
      "text": "Movies completely lied to you, jumping in a falling elevator won't save your life, and here's the brutal physics why."
    },
    {
      "id": "L2",
      "beatId": "B2",
      "speaker": "narrator",
      "start": 5.35,
      "end": 9.75,
      "text": "When those steel cables snap high above the lobby, you and the elevator plunge together at fifty miles an hour."
    },
    {
      "id": "L3",
      "beatId": "B3",
      "speaker": "narrator",
      "start": 10.15,
      "end": 14.75,
      "text": "Your legs only jump upward at two miles an hour, barely denting the crash, while your skull can slam the ceiling first."
    },
    {
      "id": "L4",
      "beatId": "B4",
      "speaker": "narrator",
      "start": 15.2,
      "end": 20.3,
      "text": "At impact, you still strike the bottom at forty-eight miles an hour, driving twenty-eight Gs straight through your shins and spine."
    },
    {
      "id": "L5",
      "beatId": "B5",
      "speaker": "narrator",
      "start": 20.8,
      "end": 25.25,
      "text": "Real shafts fire steel safety clamps onto the rails, and if one ever fails, your only real chance is lying flat on your back."
    },
    {
      "id": "L6",
      "beatId": "B6",
      "speaker": "narrator",
      "start": 25.7,
      "end": 29.6,
      "text": "Spreading flat multiplies contact area twelve times over, sparing your spine and skull from lethal shock."
    }
  ],
